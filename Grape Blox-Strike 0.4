    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -20, 0, 30)
    frame.Position = UDim2.new(0, 10, 0, 15 + (#parent:GetChildren() - 1) * 35)
    frame.BackgroundColor3 = Color3.new(1, 1, 1)
    frame.BorderSizePixel = 0

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(0, 80, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(0, 0, 0)
    label.TextSize = 14
    label.Font = Enum.Font.SourceSans
    label.TextXAlignment = Enum.TextXAlignment.Left

    local val = default
    local valLbl = Instance.new("TextLabel", frame)
    valLbl.Size = UDim2.new(0, 40, 1, 0)
    valLbl.Position = UDim2.new(1, -85, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(val)
    valLbl.TextColor3 = Color3.new(0, 0, 0)
    valLbl.TextSize = 14
    valLbl.Font = Enum.Font.SourceSans

    local minus = Instance.new("TextButton", frame)
    minus.Size = UDim2.new(0, 20, 0, 20)
    minus.Position = UDim2.new(1, -40, 0.5, -10)
    minus.Text = "-"
    minus.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8)
    minus.TextColor3 = Color3.new(0, 0, 0)
    minus.Font = Enum.Font.SourceSansBold
    minus.TextSize = 14
    minus.BorderSizePixel = 0
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local plus = Instance.new("TextButton", frame)
    plus.Size = UDim2.new(0, 20, 0, 20)
    plus.Position = UDim2.new(1, -15, 0.5, -10)
    plus.Text = "+"
    plus.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8)
    plus.TextColor3 = Color3.new(0, 0, 0)
    plus.Font = Enum.Font.SourceSansBold
    plus.TextSize = 14
    plus.BorderSizePixel = 0
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

    local function update()
        valLbl.Text = tostring(val)
        callback(val)
    end
    minus.MouseButton1Click:Connect(function()
        val = math.max(min, val - step)
        update()
    end)
    plus.MouseButton1Click:Connect(function()
        val = math.min(max, val + step)
        update()
    end)
    update()
    return {Set = function(v) val = v; update() end}
end

