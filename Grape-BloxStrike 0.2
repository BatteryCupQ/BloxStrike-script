-- FOV РУК — БЕЗ ИЗМЕНЕНИЯ Camera.FieldOfView
-- Масштабируем Arms модель вместо камеры
-- Это не детектируется т.к. не трогает FieldOfView
---------------------------------------------------

local _fovOn  = false
local _fovVal = 1.0  -- масштаб (0.5 = меньше, 2.0 = больше)

local function _applyArmsScale(scale)
	pcall(function()
		if not _lp.Character then return end
		-- Ищем руки / оружие в персонаже
		for _, obj in ipairs(_lp.Character:GetDescendants()) do
			if obj:IsA("BasePart") then
				local n = obj.Name:lower()
				if n:find("arm") or n:find("hand") or n:find("gun")
				or n:find("weapon") or n:find("tool") then
					obj.Size = obj.Size * scale
				end
			end
		end
		-- Также ищем Tool в Character
		local tool = _lp.Character:FindFirstChildOfClass("Tool")
		if tool then
			for _, p in ipairs(tool:GetDescendants()) do
				if p:IsA("BasePart") then
					p.LocalTransparencyModifier = 0
				end
			end
		end
	end)
end

-- Безопасный FOV через CFrame смещение камеры
local _origCF = nil
local _fovConn = nil

local function _enableFov()
	_fovConn = _RS.RenderStepped:Connect(function()
		pcall(function()
			if not _lp.Character then return end
			local root = _root(_lp.Character)
			if not root then return end
			-- Смещаем точку зрения вперёд — визуально руки выглядят больше
			-- Не трогаем FieldOfView
			local offset = (_fovVal - 1.0) * 0.8
			_cam.CFrame = _cam.CFrame * CFrame.new(0, 0, -offset)
		end)
	end)
end

local function _disableFov()
	if _fovConn then _fovConn:Disconnect(); _fovConn = nil end
end

