---------------------------------------------------
-- ESP
-- Blox Strike хранит врагов в workspace
-- Ищем ВСЕ модели с Humanoid — не только Players
---------------------------------------------------

local _eg = Instance.new("ScreenGui")
_eg.Name = "_GBE"; _eg.ResetOnSpawn = false; _eg.Parent = _CG

local function _root(m)
	if not m then return nil end
	return m:FindFirstChild("HumanoidRootPart")
		or m:FindFirstChild("Torso")
		or m:FindFirstChild("Head")
end

-- Тим чек: возвращает true если это враг
local function _isEnemy(model)
	if not model or not model.Parent then return false end
	if model == _lp.Character then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	-- Проверяем через Players
	for _, p in pairs(_P:GetPlayers()) do
		if p.Character == model then
			if p == _lp then return false end
			-- Тим чек
			if _lp.Team and p.Team and _lp.Team == p.Team then
				return false
			end
			return true
		end
	end
	-- Если модель не принадлежит никакому игроку — пропускаем
	-- (чтобы не рисовать рандомные объекты)
	return false
end

local function _w2s(pos)
	local s = _cam:WorldToScreenPoint(pos)
	return Vector2.new(s.X, s.Y), s.Z > 0
end

local function _ln(x1,y1,x2,y2,c,th)
	local dx=x2-x1; local dy=y2-y1
	local l=math.sqrt(dx*dx+dy*dy)
	if l < 1 then return end
	local f = Instance.new("Frame", _eg)
	f.BackgroundColor3=c; f.BorderSizePixel=0
	f.Size=UDim2.new(0,l,0,th or 2)
	f.Position=UDim2.new(0,x1,0,y1)
	f.Rotation=math.deg(math.atan2(dy,dx)); f.ZIndex=3
end

local function _box(cx,cy,w,h,c)
	_ln(cx-w/2,cy-h/2,cx+w/2,cy-h/2,c)
	_ln(cx+w/2,cy-h/2,cx+w/2,cy+h/2,c)
	_ln(cx+w/2,cy+h/2,cx-w/2,cy+h/2,c)
	_ln(cx-w/2,cy+h/2,cx-w/2,cy-h/2,c)
end

local function _txt(t,c,x,y)
	local l = Instance.new("TextLabel", _eg)
	l.Size=UDim2.new(0,120,0,16); l.Position=UDim2.new(0,x-60,0,y)
	l.BackgroundColor3=Color3.new(0,0,0); l.BackgroundTransparency=0.5
	l.TextColor3=c; l.Font=Enum.Font.GothamBold
	l.TextScaled=true; l.BorderSizePixel=0; l.ZIndex=4; l.Text=t
end

_RS.RenderStepped:Connect(function()
	pcall(function()
		for _, c in pairs(_eg:GetChildren()) do c:Destroy() end
		if not _espOn then return end
		if not _lp.Character then return end

		local mr = _root(_lp.Character)
		if not mr then return end

		-- Сканируем ВСЕХ игроков
		for _, p in ipairs(_P:GetPlayers()) do
			if p == _lp then continue end
			local char = p.Character
			if not char then continue end

			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then continue end

			-- Тим чек
			if _lp.Team and p.Team and _lp.Team == p.Team then continue end

			local root = _root(char)
			if not root then continue end

			local sp, vis = _w2s(root.Position)
			if not vis then continue end

			local dist = (root.Position - mr.Position).Magnitude
			local pct  = hum.Health / math.max(hum.MaxHealth, 1)

			local col = Color3.fromRGB(0, 220, 0)
			if pct < 0.5  then col = Color3.fromRGB(220, 220, 0) end
			if pct < 0.25 then col = Color3.fromRGB(220, 0,   0) end

			-- Получаем высоту персонажа через Head
			local head = char:FindFirstChild("Head")
			local headSP = head and select(1, _w2s(head.Position)) or Vector2.new(sp.X, sp.Y - 30)
			local bh = math.abs(sp.Y - headSP.Y) * 2.2
			local bw = bh * 0.55

			_box(sp.X, sp.Y - bh/4, math.max(bw, 30), math.max(bh, 50), col)
			_txt(p.Name, Color3.fromRGB(220,220,220), sp.X, sp.Y - bh/4 - math.max(bh,50)/2 - 16)
			_txt(string.format("%.0fHP", hum.Health), col, sp.X, sp.Y - bh/4 + math.max(bh,50)/2 + 2)
			_txt(string.format("%.0fm", dist), Color3.fromRGB(200,200,100), sp.X, sp.Y - bh/4 + math.max(bh,50)/2 + 18)
		end
	end)
end)

---------------------------------------------------
-- FOV РУК — БЕЗ ИЗМЕНЕНИЯ Camera.FieldOfView
-- Масштабируем Arms модель вместо камеры
-- Это не детектируется т.к. не трогает FieldOfView
---------------------------------------------------

local _fovOn  = false
local _fovVal = 1.0  -- масштаб (0.5 = меньше, 2.0 = больше)

local function _applyArmsScale(scale)
	pcall(function()
		if not _lp.Character then return end
		-- Ищем руки / оружие в персонаже
		for _, obj in ipairs(_lp.Character:GetDescendants()) do
			if obj:IsA("BasePart") then
				local n = obj.Name:lower()
				if n:find("arm") or n:find("hand") or n:find("gun")
				or n:find("weapon") or n:find("tool") then
					obj.Size = obj.Size * scale
				end
			end
		end
		-- Также ищем Tool в Character
		local tool = _lp.Character:FindFirstChildOfClass("Tool")
		if tool then
			for _, p in ipairs(tool:GetDescendants()) do
				if p:IsA("BasePart") then
					p.LocalTransparencyModifier = 0
				end
			end
		end
	end)
end

-- Безопасный FOV через CFrame смещение камеры
local _origCF = nil
local _fovConn = nil

local function _enableFov()
	_fovConn = _RS.RenderStepped:Connect(function()
		pcall(function()
			if not _lp.Character then return end
			local root = _root(_lp.Character)
			if not root then return end
			-- Смещаем точку зрения вперёд — визуально руки выглядят больше
			-- Не трогаем FieldOfView
			local offset = (_fovVal - 1.0) * 0.8
			_cam.CFrame = _cam.CFrame * CFrame.new(0, 0, -offset)
		end)
	end)
end

local function _disableFov()
	if _fovConn then _fovConn:Disconnect(); _fovConn = nil end
end

