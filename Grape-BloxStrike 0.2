	fl.BackgroundColor3 = Color3.fromRGB(30,30,30); fl.BorderSizePixel = 0
	Instance.new("UICorner", fl).CornerRadius = UDim.new(1,0)

	local th = Instance.new("TextButton", tr)
	th.Size = UDim2.new(0,18,0,18); th.Position = UDim2.new(pct0,-9,0.5,-9)
	th.BackgroundColor3 = Color3.fromRGB(255,255,255); th.BorderSizePixel = 0
	th.Text = ""; Instance.new("UICorner", th).CornerRadius = UDim.new(1,0)

	local drag = false
	th.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch
		or i.UserInputType == Enum.UserInputType.MouseButton1 then
			drag = true
		end
	end)
	_UI.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch
		or i.UserInputType == Enum.UserInputType.MouseButton1 then
			drag = false
		end
	end)
	_UI.InputChanged:Connect(function(i)
		if not drag then return end
		if i.UserInputType ~= Enum.UserInputType.Touch
		and i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		pcall(function()
			local p = math.clamp((i.Position.X - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
			_fovVal = 0.5 + p * 1.5  -- диапазон 0.5..2.0
			vl.Text = string.format("%.1f", _fovVal)
			fl.Size = UDim2.new(p,0,1,0)
			th.Position = UDim2.new(p,-9,0.5,-9)
		end)
	end)
end

