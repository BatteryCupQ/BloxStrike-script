-- ESP
-- ============ ESP ДЛЯ BLOX STRIKE ============
local ESP_Config = {
    Enabled = true,
    BoxColor = Color3.fromRGB(255, 50, 50),
    BoxThickness = 2,
    TextColor = Color3.fromRGB(255, 255, 255),
    TextSize = 18,
    ToggleKey = Enum.KeyCode.RightControl,
    ShowTeammates = false,
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local HEAD_NAME = "Head"
local ROOT_NAME = "HumanoidRootPart"

local espObjects = {}

local function createESP(player)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = ESP_Config.BoxColor
    box.Thickness = ESP_Config.BoxThickness
    box.Filled = false

    local distText = Drawing.new("Text")
    distText.Visible = false
    distText.Color = ESP_Config.TextColor
    distText.Font = Drawing.Fonts.UI
    distText.Size = ESP_Config.TextSize
    distText.Center = true
    distText.Outline = true
    distText.OutlineColor = Color3.new(0, 0, 0)

    espObjects[player] = {Box = box, Text = distText}
end

local function removeESP(player)
    if espObjects[player] then
        espObjects[player].Box:Remove()
        espObjects[player].Text:Remove()
        espObjects[player] = nil
    end
end

local function updateESP()
    local localChar = LocalPlayer.Character
    if not localChar then return end
    local localRoot = localChar:FindFirstChild(ROOT_NAME)
    if not localRoot then return end

    for player, esp in pairs(espObjects) do
        local char = player.Character
        if not char or player == LocalPlayer then
            esp.Box.Visible = false
            esp.Text.Visible = false
            continue
        end

        local head = char:FindFirstChild(HEAD_NAME)
        local root = char:FindFirstChild(ROOT_NAME)
        local humanoid = char:FindFirstChildOfClass("Humanoid")

        if not (head and root and humanoid and humanoid.Health > 0) then
            esp.Box.Visible = false
            esp.Text.Visible = false
            continue
        end

        if not ESP_Config.ShowTeammates and player.Team == LocalPlayer.Team then
            esp.Box.Visible = false
            esp.Text.Visible = false
            continue
        end

        local rootPos, onScreen = Camera:WorldToScreenPoint(root.Position)
        if not onScreen then
            esp.Box.Visible = false
            esp.Text.Visible = false
            continue
        end

        local headPos = Camera:WorldToScreenPoint(head.Position + Vector3.new(0, 0.6, 0))
        local feetPos = Camera:WorldToScreenPoint(root.Position - Vector3.new(0, 2.7, 0))

        local height = math.abs(headPos.Y - feetPos.Y)
        local width = height / 1.8
        local boxX = rootPos.X - width / 2
        local boxY = headPos.Y

        esp.Box.Size = Vector2.new(width, height)
        esp.Box.Position = Vector2.new(boxX, boxY)
        esp.Box.Visible = true

        local distance = (root.Position - localRoot.Position).Magnitude
        esp.Text.Text = string.format("%.0f m", distance)
        esp.Text.Position = Vector2.new(rootPos.X, headPos.Y - 22)
        esp.Text.Visible = true
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        createESP(player)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        createESP(player)
    end
end)

Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    if not ESP_Config.Enabled then
        for _, esp in pairs(espObjects) do
            esp.Box.Visible = false
            esp.Text.Visible = false
        end
        return
    end
    updateESP()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == ESP_Config.ToggleKey then
        ESP_Config.Enabled = not ESP_Config.Enabled
    end
end)

