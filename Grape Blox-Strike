-- Blox Strike хранит врагов в папке workspace
-- Пробуем несколько вариантов
local function _getEnemyFolder()
	local ws = workspace
	-- Вариант 1: папка Characters
	local f = ws:FindFirstChild("Characters")
		or ws:FindFirstChild("Players")
		or ws:FindFirstChild("Enemies")
		or ws:FindFirstChild("Team1")
		or ws:FindFirstChild("Team2")
	if f then return f end
	return nil
end

local function _getRoot(char)
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("Head")
end

-- Команда игрока
local function _isEnemy(model)
	if not model or not model:IsA("Model") then return false end
	-- Не наш персонаж
	if model == _lp.Character then return false end
	-- Проверяем Humanoid
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	-- Тим чек через Players
	for _, p in pairs(_s1:GetPlayers()) do
		if p.Character == model then
			if p == _lp then return false end
			if _lp.Team and p.Team and _lp.Team == p.Team then return false end
			return true
		end
	end
	-- Если модель не привязана к игроку — это NPC/враг
	return true
end

local function _w2s(pos)
	local sp = _cam:WorldToScreenPoint(pos)
	return Vector2.new(sp.X, sp.Y), sp.Z > 0
end

local function _drawLine(x1,y1,x2,y2,col,thick)
	local dx=x2-x1; local dy=y2-y1
	local len=math.sqrt(dx*dx+dy*dy)
	if len<1 then return end
	local f=Instance.new("Frame")
	f.BackgroundColor3=col; f.BorderSizePixel=0
	f.Size=UDim2.new(0,len,0,thick or 2)
	f.Position=UDim2.new(0,x1,0,y1)
	f.Rotation=math.deg(math.atan2(dy,dx))
	f.ZIndex=3; f.Parent=_eg
end

local function _drawBox(cx,cy,w,h,col)
	_drawLine(cx-w/2,cy-h/2,cx+w/2,cy-h/2,col)
	_drawLine(cx+w/2,cy-h/2,cx+w/2,cy+h/2,col)
	_drawLine(cx+w/2,cy+h/2,cx-w/2,cy+h/2,col)
	_drawLine(cx-w/2,cy+h/2,cx-w/2,cy-h/2,col)
end

local function _drawTxt(txt,col,x,y)
	local l=Instance.new("TextLabel")
	l.Size=UDim2.new(0,120,0,16)
	l.Position=UDim2.new(0,x-60,0,y)
	l.BackgroundColor3=Color3.new(0,0,0)
	l.BackgroundTransparency=0.5
	l.TextColor3=col; l.Font=Enum.Font.GothamBold
	l.TextScaled=true; l.BorderSizePixel=0
	l.ZIndex=4; l.Text=txt; l.Parent=_eg
end

_s2.RenderStepped:Connect(function()
	pcall(function()
		for _,c in pairs(_eg:GetChildren()) do c:Destroy() end
		if not _ESPEnabled then return end
		if not _lp.Character then return end
		local myRoot = _getRoot(_lp.Character)
		if not myRoot then return end

		-- Ищем врагов двумя способами одновременно

		-- Способ 1: через Players (стандарт)
		for _, p in ipairs(_s1:GetPlayers()) do
			if p ~= _lp and p.Character then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					if not (_lp.Team and p.Team and _lp.Team == p.Team) then
						local root = _getRoot(p.Character)
						if root then
							local sp, vis = _w2s(root.Position)
							if vis then
								local dist = (root.Position - myRoot.Position).Magnitude
								local pct = hum.Health / hum.MaxHealth
								local col = Color3.fromRGB(0,220,0)
								if pct < 0.5  then col = Color3.fromRGB(220,220,0) end
								if pct < 0.25 then col = Color3.fromRGB(220,0,0) end
								_drawBox(sp.X, sp.Y, 44, 65, col)
								_drawTxt(p.Name, Color3.fromRGB(220,220,220), sp.X, sp.Y-52)
								_drawTxt(string.format("HP %.0f", hum.Health), col, sp.X, sp.Y+36)
								_drawTxt(string.format("%.0fm", dist), Color3.fromRGB(200,200,100), sp.X, sp.Y+52)
							end
						end
					end
				end
			end
		end

		-- Способ 2: через workspace папку (для ботов/NPC)
		local folder = _getEnemyFolder()
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if _isEnemy(model) then
					local hum = model:FindFirstChildOfClass("Humanoid")
					local root = _getRoot(model)
					if hum and root then
						local sp, vis = _w2s(root.Position)
						if vis then
							local dist = (root.Position - myRoot.Position).Magnitude
							local pct = hum.Health / hum.MaxHealth
							local col = Color3.fromRGB(0,220,0)
							if pct < 0.5  then col = Color3.fromRGB(220,220,0) end
							if pct < 0.25 then col = Color3.fromRGB(220,0,0) end
							_drawBox(sp.X, sp.Y, 44, 65, col)
							_drawTxt(model.Name, Color3.fromRGB(220,220,220), sp.X, sp.Y-52)
							_drawTxt(string.format("HP %.0f", hum.Health), col, sp.X, sp.Y+36)
							_drawTxt(string.format("%.0fm", dist), Color3.fromRGB(200,200,100), sp.X, sp.Y+52)
						end
					end
				end
			end
		end
	end)
end)

