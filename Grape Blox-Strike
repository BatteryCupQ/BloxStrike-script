local function _switch(tab)
	_vp.Visible  = (tab=="vis")
	_ap.Visible  = (tab=="auth")
	_visBtn.TextColor3  = Color3.fromRGB(120,120,120)
	_authBtn.TextColor3 = Color3.fromRGB(120,120,120)
	if tab=="vis" then
		_tind.Position = UDim2.new(0,3,0,3)
		_visBtn.TextColor3 = Color3.fromRGB(40,40,40)
	else
		_tind.Position = UDim2.new(0.5,1,0,3)
		_authBtn.TextColor3 = Color3.fromRGB(40,40,40)
	end
end

_visBtn.MouseButton1Click:Connect(function()  _switch("vis")  end)
_authBtn.MouseButton1Click:Connect(function() _switch("auth") end)

