local function _makeFovSlider(par, y)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1,0,0,70); frame.Position = UDim2.new(0,0,0,y)
	frame.BackgroundColor3 = Color3.fromRGB(255,255,255)
	frame.BorderSizePixel = 0; frame.Parent = par
	local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0,12); fc.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1,-80,0,24); title.Position = UDim2.new(0,14,0,8)
	title.BackgroundTransparency = 1; title.Text = "FOV рук"
	title.TextColor3 = Color3.fromRGB(40,40,40); title.Font = Enum.Font.Gotham
	title.TextSize = 15; title.TextXAlignment = Enum.TextXAlignment.Left; title.Parent = frame

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0,60,0,24); valLbl.Position = UDim2.new(1,-74,0,8)
	valLbl.BackgroundTransparency = 1; valLbl.Text = tostring(_fovValue)
	valLbl.TextColor3 = Color3.fromRGB(100,100,100); valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 14; valLbl.Parent = frame

	-- Полоска слайдера
	local track = Instance.new("Frame")
	track.Size = UDim2.new(1,-28,0,8); track.Position = UDim2.new(0,14,0,44)
	track.BackgroundColor3 = Color3.fromRGB(210,210,210)
	track.BorderSizePixel = 0; track.Parent = frame
	local trc = Instance.new("UICorner"); trc.CornerRadius = UDim.new(1,0); trc.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((_fovValue-30)/90, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(30,30,30)
	fill.BorderSizePixel = 0; fill.Parent = track
	local flc = Instance.new("UICorner"); flc.CornerRadius = UDim.new(1,0); flc.Parent = fill

	local thumb = Instance.new("TextButton")
	thumb.Size = UDim2.new(0,18,0,18)
	thumb.Position = UDim2.new((_fovValue-30)/90, -9, 0.5, -9)
	thumb.BackgroundColor3 = Color3.fromRGB(255,255,255)
	thumb.BorderSizePixel = 0; thumb.Text = ""; thumb.Parent = track
	local thc = Instance.new("UICorner"); thc.CornerRadius = UDim.new(1,0); thc.Parent = thumb

	-- Drag слайдера
	local dragging = false

	thumb.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch
		or inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
		end
	end)

	_s5.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch
		or inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	_s5.InputChanged:Connect(function(inp)
		if not dragging then return end
		if inp.UserInputType ~= Enum.UserInputType.Touch
		and inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end

		pcall(function()
			local abs = track.AbsolutePosition
			local sz  = track.AbsoluteSize
			local px  = inp.Position.X
			local pct = math.clamp((px - abs.X) / sz.X, 0, 1)
			_fovValue = math.floor(30 + pct * 90) -- диапазон 30–120
			valLbl.Text = tostring(_fovValue)
			fill.Size = UDim2.new(pct, 0, 1, 0)
			thumb.Position = UDim2.new(pct, -9, 0.5, -9)
			if _fovEnabled then _applyFov(_fovValue) end
		end)
	end)
end

