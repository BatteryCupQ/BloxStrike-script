-- ANTI-KICK (перехват через метатаблицу)
---------------------------------------------------

pcall(function()
	local _mt = getrawmetatable and getrawmetatable(game) or nil
	if _mt then
		local _old = _mt.__namecall
		local _rw  = make_writeable and make_writeable or (function(t,v) setreadonly(t,v) end)
		_rw(_mt, false)
		_mt.__namecall = newcclosure(function(self, ...)
			local method = getnamecallmethod and getnamecallmethod() or ""
			if method == "Kick" and self == _lp then
				return
			end
			return _old(self, ...)
		end)
		_rw(_mt, true)
	else
		-- Fallback: прямое переопределение
		_lp.Kick = function() end
	end
end)

