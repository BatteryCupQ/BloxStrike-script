-- === BULLET TRACK ===
-- Перехват пуль и перенаправление на ближайшего врага
local function getClosestPlayer()
    local localRoot = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Head"))
    if not localRoot then return nil end
    local closest = nil
    local minDist = math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head")
            if root then
                local dist = (root.Position - localRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = root
                end
            end
        end
    end
    return closest
end

-- Отслеживаем появление новых снарядов (пуль)
local function setupBulletTrack()
    local function onBullet(part)
        if not _G.Rage.bulletTrack then return end
        -- Проверяем, что это пуля (ищем по свойствам)
        if not part:IsA("BasePart") then return end
        -- Игнорируем, если это не снаряд (можно проверить наличие Velocity)
        if not part.Velocity or part.Velocity.Magnitude < 10 then return end
        -- Пытаемся определить, что пуля принадлежит локальному игроку
        -- В разных играх по-разному, пробуем проверить Parent или Creator
        local creator = part:FindFirstChild("Creator")
        if creator and creator.Value ~= LocalPlayer then return end
        -- Также можно проверить, не является ли часть частью персонажа игрока
        if part:IsDescendantOf(LocalPlayer.Character) then return end
        
        -- Находим ближайшего врага
        local targetRoot = getClosestPlayer()
        if not targetRoot then return end
        
        -- Перенаправляем пулю
        local direction = (targetRoot.Position - part.Position).Unit
        local speed = part.Velocity.Magnitude
        part.Velocity = direction * speed
    end
    
    -- Подключаемся к появлению новых частей
    workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") then
            onBullet(obj)
        end
    end)
    
    -- Также проверяем уже существующие части (если пули уже летят)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            onBullet(obj)
        end
    end
end

-- Запускаем Bullet Track (он будет работать в фоне, проверяя флаг)
