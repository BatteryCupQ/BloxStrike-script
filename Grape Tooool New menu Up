-- Функция создания ESP для игроков (бокс, HP, имя)
local function createPlayerESP(model)
    if not model or model == LocalPlayer.Character then return end
    for _, child in pairs(model:GetChildren()) do
        if child:IsA("BillboardGui") and child.Name:find("ESP_") then
            return
        end
    end

    local adornee = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
    if not adornee then adornee = model end

    local bill = Instance.new("BillboardGui")
    bill.Name = "ESP_" .. tostring(math.random(1000,9999))
    bill.Size = UDim2.new(0, 120, 0, 80)
    bill.AlwaysOnTop = true
    bill.Adornee = adornee
    bill.Parent = model

    -- Бокс (рамка)
    local box = Instance.new("Frame")
    box.Name = "Box"
    box.Size = UDim2.new(1, 0, 1, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 2
    box.BorderColor3 = Color3.new(1, 1, 1)
    box.Visible = _G.ESP.showBox
    box.Parent = bill

    -- Имя
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Name"
    nameLabel.Size = UDim2.new(1, 0, 0.25, 0)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = model.Name or "Player"
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Visible = _G.ESP.showNames
    nameLabel.Parent = box

    -- HP
    local hpBar = Instance.new("Frame")
    hpBar.Name = "HPBar"
    hpBar.Size = UDim2.new(0.8, 0, 0.15, 0)
    hpBar.Position = UDim2.new(0.1, 0, 0.7, 0)
