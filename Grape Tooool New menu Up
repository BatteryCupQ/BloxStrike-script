    label.Parent = frame

    return {bill = bill, frame = frame}
end

-- Поиск целей (игроки + бомба)
local function getTargets()
    local targets = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChildOfClass("Humanoid") then
            table.insert(targets, p.Character)
        end
    end
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj ~= LocalPlayer.Character then
            local found = false
            for _, t in ipairs(targets) do if t == obj then found = true break end end
            if not found then table.insert(targets, obj) end
        end
    end
    return targets
end

local function getBomb()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Part") then
            local name = obj.Name:lower()
            if name:find("bomb") or name:find("c4") or name:find("explosive") then
                return obj
            end
        end
    end
    return nil
end

-- Линии (через Drawing, если доступно)
local function updateLines()
    if not _G.ESP.showLines or not _G.ESP.enabled then
        for _, line in pairs(_G.ESP.lines) do
            line:Remove()
        end
        _G.ESP.lines = {}
        return
    end

    if not hasDrawing then return end

    local localRoot = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Head"))
    if not localRoot then return end
    local center = Camera:WorldToViewportPoint(localRoot.Position)
    local centerVec = Vector2.new(center.X, center.Y)

    local targets = getTargets()
    -- Удаляем старые линии для мёртвых целей
    for i = #_G.ESP.lines, 1, -1 do
        local line = _G.ESP.lines[i]
        if not line or not line._target or not table.find(targets, line._target) then
            line:Remove()
            table.remove(_G.ESP.lines, i)
        end
    end

    for _, model in ipairs(targets) do
        local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
        if root then
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                local line = nil
                for _, l in pairs(_G.ESP.lines) do
                    if l._target == model then line = l break end
                end
                if not line then
                    line = Drawing.new("Line")
                    line.Thickness = 1
                    line.Color = Color3.fromRGB(255, 0, 170)
                    line.Transparency = 0.5
                    line._target = model
                    table.insert(_G.ESP.lines, line)
                end
                line.From = centerVec
                line.To = Vector2.new(pos.X, pos.Y)
                line.Visible = true
            else
                for _, l in pairs(_G.ESP.lines) do
                    if l._target == model then l.Visible = false end
                end
            end
        end
    end
end

-- Основное обновление ESP
local function updateESP()
    if not _G.ESP.enabled then
        -- Очистка
        for _, data in pairs(_G.ESP.objects) do
            data.bill:Destroy()
        end
        _G.ESP.objects = {}
        for _, line in pairs(_G.ESP.lines) do
            line:Remove()
        end
        _G.ESP.lines = {}
        return
    end

    -- Игроки
    local targets = getTargets()
    for model, data in pairs(_G.ESP.objects) do
        if not table.find(targets, model) then
            data.bill:Destroy()
            _G.ESP.objects[model] = nil
        end
    end

    for _, model in ipairs(targets) do
        local data = _G.ESP.objects[model]
        if not data then
            data = createPlayerESP(model)
            if data then _G.ESP.objects[model] = data end
        end
        if data then
            data.box.Visible = _G.ESP.showBox
            data.nameLabel.Visible = _G.ESP.showNames
            data.hpBar.Visible = _G.ESP.showHP
            data.hpText.Visible = _G.ESP.showHP

            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local hp = humanoid.Health
                local maxHp = humanoid.MaxHealth or 100
                local percent = math.clamp(hp / maxHp, 0, 1)
                data.hpBar.Size = UDim2.new(0.8 * percent, 0, 0.15, 0)
                data.hpBar.BackgroundColor3 = Color3.new(1 - percent, percent, 0)
                data.hpText.Text = string.format("%.0f / %.0f HP", hp, maxHp)
            end
        end
    end

    -- Линии
    updateLines()

    -- Bomb ESP
    if _G.ESP.bombEnabled then
        local bomb = getBomb()
        if bomb then
            local found = false
            for _, child in pairs(bomb:GetChildren()) do
                if child:IsA("BillboardGui") and child.Name:find("BombESP") then
                    found = true
                    break
                end
            end
            if not found then
                createBombESP(bomb)
            end
        end
    else
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BillboardGui") and obj.Name:find("BombESP") then
                obj:Destroy()
            end
        end
    end
end

