    f.Position = UDim2.new(0, 10, 0, 15 + (#parent:GetChildren() * 35))
    f.BackgroundColor3 = Color3.new(1, 1, 1); f.BorderSizePixel = 0
    local lbl = Instance.new("TextLabel", f)
    lbl.Size = UDim2.new(0, 80, 1, 0); lbl.BackgroundTransparency = 1
    lbl.Text = text; lbl.TextColor3 = Color3.new(0, 0, 0)
    lbl.TextSize = 14; lbl.Font = Enum.Font.SourceSans; lbl.TextXAlignment = Enum.TextXAlignment.Left
    local val = default
    local valLbl = Instance.new("TextLabel", f)
    valLbl.Size = UDim2.new(0, 40, 1, 0); valLbl.Position = UDim2.new(1, -85, 0, 0)
    valLbl.BackgroundTransparency = 1; valLbl.Text = tostring(val); valLbl.TextColor3 = Color3.new(0, 0, 0)
    valLbl.TextSize = 14; valLbl.Font = Enum.Font.SourceSans
    local minus = Instance.new("TextButton", f)
    minus.Size = UDim2.new(0, 20, 0, 20); minus.Position = UDim2.new(1, -40, 0.5, -10)
    minus.Text = "-"; minus.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8); minus.TextColor3 = Color3.new(0, 0, 0)
    minus.Font = Enum.Font.SourceSansBold; minus.TextSize = 14; minus.BorderSizePixel = 0
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)
    local plus = Instance.new("TextButton", f)
    plus.Size = UDim2.new(0, 20, 0, 20); plus.Position = UDim2.new(1, -15, 0.5, -10)
    plus.Text = "+"; plus.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8); plus.TextColor3 = Color3.new(0, 0, 0)
    plus.Font = Enum.Font.SourceSansBold; plus.TextSize = 14; plus.BorderSizePixel = 0
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)
    local function update()
        valLbl.Text = tostring(val); callback(val)
        -- обновить круг FOV
        if text == "FOV" then
            fovCircle.Size = UDim2.new(0, val*2, 0, val*2)
            fovCircle.Position = UDim2.new(0.5, -val, 0.5, -val)
        end
    end
    minus.MouseButton1Click:Connect(function() val = math.max(min, val-5); update() end)
    plus.MouseButton1Click:Connect(function() val = math.min(max, val+5); update() end)
    update()
    return {Set = function(v) val = v; update() end}
end

createSliderAim(contentAim, "FOV", 50, 500, 200, function(v) Aim.FOV = v end)
createSliderAim(contentAim, "Smooth", 1, 10, 1, function(v) Aim.Smoothness = v end)

-- Перетаскивание Aim меню
local dragAim, dsAim, fsAim = false, nil, nil
titleAim.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch then
        dragAim = true; dsAim = i.Position; fsAim = mainAim.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragAim and i.UserInputType == Enum.UserInputType.Touch then
        local d = i.Position - dsAim
        mainAim.Position = UDim2.new(fsAim.X.Scale, fsAim.X.Offset+d.X, fsAim.Y.Scale, fsAim.Y.Offset+d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch then dragAim = false end
end)

UserInputService.InputBegan:Connect(function(i,g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        mainAim.Visible = not mainAim.Visible
    end
end)

-- Показывать/скрывать круг FOV в зависимости от включения аима
RunService.RenderStepped:Connect(function()
    fovCircle.Visible = Aim.Enabled
    if not Aim.Enabled then targetDot.Visible = false end
end)

