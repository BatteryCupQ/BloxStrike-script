-- Функция проверки видимости (raycast от камеры до цели)
local function isVisible(targetPart)
    if not Aim.VisibilityCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
    local ray = Ray.new(origin, dir)
    local hit = Workspace:FindPartOnRay(ray, LocalPlayer.Character, false, true)
    if hit then
        -- проверяем, принадлежит ли hit персонажу цели
        local char = targetPart.Parent
        return char and hit:IsDescendantOf(char)
    end
    return false
end

local function getClosestPlayerInFOV()
    local mousePos = Camera.ViewportSize / 2
    local closest = nil
    local minDist = Aim.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local aimPart = char:FindFirstChild(Aim.AimPart)
            if not aimPart then aimPart = char:FindFirstChild("Head") end
            if aimPart then
                local pos, onScreen = Camera:WorldToScreenPoint(aimPart.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < minDist then
                        -- проверка команды
                        if not Aim.TeamCheck or (function()
                            local t; pcall(function() t = p.Team end)
                            return t and LocalPlayer.Team and t ~= LocalPlayer.Team
                        end)() or not Aim.TeamCheck then
                            -- проверка видимости
                            if isVisible(aimPart) then
                                closest = p
                                minDist = dist
                            end
                        end
                    end
                end
            end
        end
    end
    -- обновляем точку цели
    if closest then
        local ap = closest.Character:FindFirstChild(Aim.AimPart)
        if ap then
            local sp = Camera:WorldToScreenPoint(ap.Position)
            targetDot.Position = UDim2.new(0, sp.X-5, 0, sp.Y-5)
            targetDot.Visible = true
        else
            targetDot.Visible = false
        end
    else
        targetDot.Visible = false
    end
    return closest
end

-- Перехват RemoteEvent для оружия
local weaponRemote = nil
local oldFireServer = nil

local function findWeaponRemote()
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = v.Name:lower()
            if n:find("shoot") or n:find("fire") or n:find("bullet") or n:find("weapon") then
                return v
            end
        end
    end
    local rs = game:GetService("ReplicatedStorage")
    for _, v in ipairs(rs:GetDescendants()) do
        if v:IsA("RemoteEvent") then return v end
    end
    return nil
end

local function setupSilentAim()
    weaponRemote = findWeaponRemote()
    if not weaponRemote then
        warn("Не найден RemoteEvent для оружия. Silent Aim не запущен.")
        return
    end
    oldFireServer = hookfunction(weaponRemote.FireServer, function(self, ...)
        local args = {...}
        if Aim.Enabled then
            local target = getClosestPlayerInFOV()
            if target and target.Character then
                local aimPart = target.Character:FindFirstChild(Aim.AimPart) or target.Character:FindFirstChild("Head")
                if aimPart then
                    -- ожидаем, что аргументы: origin (Vector3), direction (Vector3)
                    if #args >= 2 and typeof(args[1])=="Vector3" and typeof(args[2])=="Vector3" then
                        local origin = args[1]
                        local targetPos = aimPart.Position
                        local newDir = (targetPos - origin).Unit
                        if Aim.Smoothness > 1 then
                            local oldDir = args[2]
                            args[2] = oldDir:Lerp(newDir, 1/Aim.Smoothness)
                        else
                            args[2] = newDir
                        end
                    end
                end
            end
        end
        return oldFireServer(self, unpack(args))
    end)
    print("Silent Aim привязан к:", weaponRemote:GetFullName())
end

