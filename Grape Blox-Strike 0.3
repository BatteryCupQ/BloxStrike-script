espGui.Parent = game.CoreGui

function createLine()
    local line = Instance.new("Frame")
    line.BackgroundColor3 = ESP.SkeletonColor
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.Size = UDim2.new(0, 0, 0, 2)
    line.Visible = false
    line.Parent = espGui
    return line
end

function createESP(player)
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = espGui
    local stroke = Instance.new("UIStroke")
    stroke.Color = ESP.BoxColor
    stroke.Thickness = 2
    stroke.Parent = box

    local distText = Instance.new("TextLabel")
    distText.BackgroundTransparency = 1
    distText.TextColor3 = ESP.TextColor
    distText.Font = Enum.Font.SourceSansBold
    distText.TextSize = ESP.TextSize
    distText.TextStrokeTransparency = 0
    distText.Visible = false
    distText.Parent = espGui

    local connections = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
        {"RightLowerArm","RightHand"},{"UpperTorso","LeftUpperArm"},
        {"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},
        {"RightLowerLeg","RightFoot"},{"LowerTorso","LeftUpperLeg"},
        {"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    }
    local bones = {}
    for _=1,#connections do table.insert(bones,{Line=createLine(),From=nil,To=nil}) end
    espObjects[player] = {Box=box,Stroke=stroke,Text=distText,Bones=bones,Connections=connections}
end

function removeESP(player)
    if espObjects[player] then
        espObjects[player].Box:Destroy()
        espObjects[player].Text:Destroy()
        for _,b in ipairs(espObjects[player].Bones) do b.Line:Destroy() end
        espObjects[player] = nil
    end
end

local function isEnemy(p)
    if not ESP.TeamCheck then return true end
    local t; pcall(function() t = p.Team end)
    if t and LocalPlayer.Team then return t ~= LocalPlayer.Team end
    return true
end

function updateESP()
    local lc = LocalPlayer.Character; if not lc then return end
    local lr = lc:FindFirstChild("HumanoidRootPart"); if not lr then return end
    for p,o in pairs(espObjects) do
        local c = p.Character; if c and p~=LocalPlayer then
            local h = c:FindFirstChild("Head")
            local r = c:FindFirstChild("HumanoidRootPart")
            local hm = c:FindFirstChildOfClass("Humanoid")
            if r and h and hm and hm.Health>0 then
                if isEnemy(p) then
                    local rp,on = Camera:WorldToScreenPoint(r.Position)
                    if on then
                        local hp = Camera:WorldToScreenPoint(h.Position+Vector3.new(0,0.6,0))
                        local fp = Camera:WorldToScreenPoint(r.Position-Vector3.new(0,2.7,0))
                        local ht = math.abs(hp.Y-fp.Y); local wd = ht/1.8
                        o.Box.Size = UDim2.new(0,wd,0,ht)
                        o.Box.Position = UDim2.new(0,rp.X-wd/2,0,hp.Y)
                        o.Box.Visible = true
                        local dist = (r.Position-lr.Position).Magnitude
                        o.Text.Text = string.format("%.0f m",dist)
                        o.Text.Position = UDim2.new(0,rp.X,0,hp.Y-22)
                        o.Text.Visible = true
                        for i,conn in ipairs(o.Connections) do
                            local pf = c:FindFirstChild(conn[1])
                            local pt = c:FindFirstChild(conn[2])
                            local bone = o.Bones[i]
                            if pf and pt then
                                local f = Camera:WorldToScreenPoint(pf.Position)
                                local t = Camera:WorldToScreenPoint(pt.Position)
                                if f.Z>0 and t.Z>0 then
                                    local diff = Vector2.new(t.X-f.X,t.Y-f.Y)
                                    local len = diff.Magnitude
                                    if len>0 then
                                        bone.Line.Size = UDim2.new(0,len,0,2)
                                        bone.Line.Position = UDim2.new(0,f.X,0,f.Y)
                                        bone.Line.Rotation = math.deg(math.atan2(diff.Y,diff.X))
                                        bone.Line.Visible = true
                                    else bone.Line.Visible=false end
                                else bone.Line.Visible=false end
                            else bone.Line.Visible=false end
                        end
                    else o.Box.Visible=false; o.Text.Visible=false; for _,b in ipairs(o.Bones) do b.Line.Visible=false end end
                else o.Box.Visible=false; o.Text.Visible=false; for _,b in ipairs(o.Bones) do b.Line.Visible=false end end
            else o.Box.Visible=false; o.Text.Visible=false; for _,b in ipairs(o.Bones) do b.Line.Visible=false end end
        else o.Box.Visible=false; o.Text.Visible=false; for _,b in ipairs(o.Bones) do b.Line.Visible=false end end
    end
end

