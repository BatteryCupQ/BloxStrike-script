-- Реализация ESP (полностью рабочий код)
local function createESP(model)
    if not model or model == LocalPlayer.Character then return end
    -- Проверяем, есть ли уже ESP
    for _, child in pairs(model:GetChildren()) do
        if child:IsA("BillboardGui") and child.Name:find("ESP_") then
            return
        end
    end

    local adornee = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
    if not adornee then adornee = model end

    local bill = Instance.new("BillboardGui")
    bill.Name = "ESP_" .. tostring(math.random(1000,9999))
    bill.Size = UDim2.new(0, 120, 0, 80)
    bill.AlwaysOnTop = true
    bill.Adornee = adornee
    bill.Parent = model

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 1, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 2
    box.BorderColor3 = Color3.new(1, 1, 1)
    box.Parent = bill

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.25, 0)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = model.Name or "Player"
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Parent = box

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0.2, 0)
    distLabel.Position = UDim2.new(0, 0, 0.25, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0.0 m"
    distLabel.TextColor3 = Color3.new(1, 1, 1)
    distLabel.TextScaled = true
    distLabel.Font = Enum.Font.SourceSansBold
    distLabel.Parent = box

    local hpBar = Instance.new("Frame")
    hpBar.Size = UDim2.new(0.8, 0, 0.15, 0)
    hpBar.Position = UDim2.new(0.1, 0, 0.7, 0)
    hpBar.BackgroundColor3 = Color3.new(0, 1, 0)
    hpBar.BackgroundTransparency = 0.6
    hpBar.BorderSizePixel = 0
    hpBar.Parent = box

    local hpText = Instance.new("TextLabel")
    hpText.Size = UDim2.new(1, 0, 0.2, 0)
    hpText.Position = UDim2.new(0, 0, 0.6, 0)
    hpText.BackgroundTransparency = 1
    hpText.Text = "100 HP"
    hpText.TextColor3 = Color3.new(1, 1, 1)
    hpText.TextScaled = true
    hpText.Font = Enum.Font.SourceSansBold
    hpText.Parent = box

    return {model = model, bill = bill, hpBar = hpBar, hpText = hpText, distLabel = distLabel, nameLabel = nameLabel}
end

local function getTargets()
    local targets = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChildOfClass("Humanoid") then
            table.insert(targets, p.Character)
        end
    end
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj ~= LocalPlayer.Character then
            local found = false
            for _, t in ipairs(targets) do if t == obj then found = true break end end
            if not found then table.insert(targets, obj) end
        end
    end
    return targets
end

local function updateESP()
    if not _G.ESP.enabled then
        -- Если ESP выключен, удаляем все объекты
        for _, data in pairs(_G.ESP.objects) do
            data.bill:Destroy()
        end
        _G.ESP.objects = {}
        return
    end
    
    local targets = getTargets()
    -- Удаляем для мёртвых
    for model, data in pairs(_G.ESP.objects) do
        if not table.find(targets, model) then
            data.bill:Destroy()
            _G.ESP.objects[model] = nil
        end
    end

    for _, model in ipairs(targets) do
        local data = _G.ESP.objects[model]
        if not data then
            data = createESP(model)
            if data then _G.ESP.objects[model] = data end
        end
        if data then
            -- HP
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local hp = humanoid.Health
                local maxHp = humanoid.MaxHealth or 100
                local percent = math.clamp(hp / maxHp, 0, 1)
                data.hpBar.Size = UDim2.new(0.8 * percent, 0, 0.15, 0)
                data.hpBar.BackgroundColor3 = Color3.new(1 - percent, percent, 0)
                data.hpText.Text = string.format("%.0f / %.0f HP", hp, maxHp)
            end

            -- Дистанция
            local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
            if root and LocalPlayer.Character then
                local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Head")
                if localRoot then
                    local dist = (root.Position - localRoot.Position).Magnitude
                    data.distLabel.Text = string.format("%.1f m", dist)
                end
            end

            data.nameLabel.Text = model.Name
        end
    end
end

-- Запускаем постоянное обновление ESP
_G.ESP.running = true
RunService.Heartbeat:Connect(updateESP)

