-- Подключаем кнопки меню к ESP (переопределяем их поведение, если они уже созданы)
-- Находим кнопку "ESP Вкл/Выкл" на Main и переключатель на Visual
local function setupControls()
    -- Ищем кнопку на Main
    local mainBtn = nil
    for _, child in pairs(ScreenGui:GetDescendants()) do
        if child:IsA("TextButton") and child.Text == "ESP Вкл/Выкл" then
            mainBtn = child
            break
        end
    end
    if mainBtn then
        -- Удаляем старые обработчики, чтобы не дублировать (просто заменим)
        mainBtn.MouseButton1Click:Connect(function()
            _G.ESP.enabled = not _G.ESP.enabled
            print("ESP " .. (_G.ESP.enabled and "включен" or "выключен"))
            if not _G.ESP.enabled then
                for _, data in pairs(_G.ESP.objects) do
                    data.bill:Destroy()
                end
                _G.ESP.objects = {}
            end
        end)
    end

    -- Ищем переключатель на Visual (по тексту "ESP (Враги)")
    local toggleBtn = nil
    for _, child in pairs(ScreenGui:GetDescendants()) do
        if child:IsA("TextLabel") and child.Text == "ESP (Враги)" then
            local frame = child.Parent
            if frame and frame:IsA("Frame") then
                for _, c in pairs(frame:GetChildren()) do
                    if c:IsA("TextButton") and c.Size == UDim2.new(0, 40, 0, 20) then
                        toggleBtn = c
                        break
                    end
                end
            end
        end
    end
    if toggleBtn then
        -- Переопределяем клик, чтобы синхронизировать с _G.ESP.enabled
        toggleBtn.MouseButton1Click:Connect(function()
            -- Определяем текущее состояние по положению индикатора
            local indicator = toggleBtn:FindFirstChildOfClass("Frame")
            if indicator then
                local pos = indicator.Position
                if pos.X.Offset > 10 then
                    _G.ESP.enabled = true
                else
                    _G.ESP.enabled = false
                end
                if not _G.ESP.enabled then
                    for _, data in pairs(_G.ESP.objects) do
                        data.bill:Destroy()
                    end
                    _G.ESP.objects = {}
                end
            end
        end)
    end
end

